DATABASE_URL=
PORT=4000
ENV=dev
ALLOW_ADMIN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payment simulator (callbacks are HMAC-SHA256 signed: X-Simulator-Signature: t=<unix>,v1=<hex>)
# Dev-only placeholder: refused outside local ENV, where it must be >= 32 random bytes. Empty disables the callback and simulator routes.
PAYMENT_SIMULATOR_SECRET=dev-only-simulator-secret-change-me
# Exposes /payment-simulator/*. Defaults to true when ENV is dev/development/test, otherwise false.
PAYMENT_SIMULATOR_ENABLED=
# Lets automation call /payment-simulator/* with X-Operator-Key. Empty disables operator-key access.
PAYMENT_OPERATOR_KEY=
# Where the simulator delivers events. Empty means http://127.0.0.1:<PORT>/api/payment-callbacks/simulator
PAYMENT_CALLBACK_URL=
